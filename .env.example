# ====================================================================
# LIVE STREAM SYSTEM ENVIRONMENT CONFIGURATION TEMPLATE
# Copy this file to '.env' locally and populate with your own values.
# ====================================================================

# Platforms keys (the one you're broadcasting into)
YOUR_YOUTUBE_STREAM_KEY="your_private_youtube_live_stream_key_here"
PASSWORD="choose_a_robust_internal_handshake_password"

# Cluster Communication Mesh Network Endpoints
GATEWAY_STATUS_URL="https://your-unique-app.onrender.com/status"
EMERGENCY_WAKEUP_URL="https://api.huggingface.co/spaces/yourusername/worker-a/wakeup"
NEXT_SERVER_HEALTH="https://your-backup-space.hf.space/health"
NEXT_SERVER_WAKEUP="https://api.huggingface.co/spaces/yourusername/worker-b/wakeup"

# Authentication Security Clearances
CLOUD_API_TOKEN="your_huggingface_write_token_here"